Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane Cell Count: 50
      Reference Frame: <Fixed Frame>
      Value: true

    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: EgoRobotModel
      Robot Description: robot_description
      TF Prefix: ""
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Topic: /planner/cubes
      Name: DriveCubes
      Queue Size: 100
      Value: true

    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 0
      Enabled: true
      Line Style: Billboards
      Line Width: 0.20
      Name: CoarsePath
      Offset:
        Z: 0.1
      Topic: /sim/coarse_path
      Value: true

    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 0; 0
      Enabled: true
      Line Style: Billboards
      Line Width: 0.20
      Name: OptimizedPath
      Offset:
        Z: 0.2
      Topic: /sim/opt_path
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Topic: /scene/visualization
      Name: Lanes
      Queue Size: 100
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Topic: /sim/visualization
      Name: Agents
      Queue Size: 100
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Topic: /planner/visualization
      Name: AgentPredictPath
      Queue Size: 100
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Topic: /planner/decision_text
      Name: BehaviorResult
      Queue Size: 100
      Value: true

    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF
      Value: false

  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30

  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0

  Views:
    Current:
      # ThirdPersonFollower = XYOrbit that also turns with the target frame's yaw.
      # Full mouse control still applies (left=rotate, wheel=zoom, right=push,
      # Shift+left=pan); the camera simply stays centered on Target Frame.
      Class: rviz_default_plugins/ThirdPersonFollower
      Distance: 60
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.1
      Target Frame: base_footprint
      Value: ThirdPersonFollower (rviz_default_plugins)
      Yaw: 4.71
    Saved:
      - Class: rviz_default_plugins/Orbit
        Distance: 60
        Enable Stereo Rendering:
          Stereo Eye Separation: 0.06
          Stereo Focal Distance: 1
          Swap Stereo Eyes: false
          Value: false
        Focal Point:
          X: 0
          Y: 0
          Z: 0
        Focal Shape Fixed Size: true
        Focal Shape Size: 0.05
        Invert Z Axis: false
        Name: Free orbit (no follow)
        Near Clip Distance: 0.01
        Pitch: 1.1
        Target Frame: map
        Value: Orbit (rviz_default_plugins)
        Yaw: 4.71
      - Class: rviz_default_plugins/TopDownOrtho
        Enable Stereo Rendering:
          Stereo Eye Separation: 0.06
          Stereo Focal Distance: 1
          Swap Stereo Eyes: false
          Value: false
        Invert Z Axis: false
        Name: Top-down overview
        Scale: 6
        Target Frame: map
        Value: TopDownOrtho (rviz_default_plugins)
        X: 100
        Y: 8

# RViz2 restores the main window's size and position from this block on startup,
# which is how we make it open near-fullscreen (maximized, title bar kept) by
# default. Sized for a 1920x1200 primary monitor; adjust if you change screens,
# or just resize the window and use File -> Save Config to overwrite these.
Window Geometry:
  Height: 1130
  Width: 1850
  X: 35
  Y: 275
