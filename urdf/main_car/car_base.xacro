<!-- 底盘 - ROS1 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="car_length" value="5.0"/>
    <xacro:property name="car_width"  value="2.0"/>
    <xacro:property name="car_height" value="1.4"/>
    <xacro:property name="ground_height" value="0.4"/>

    <xacro:include filename="$(find lane_change_sim)/urdf/main_car/car_wheels.xacro"/>

    <material name="yellow">
        <color rgba="0.9 0.6 0.0 0.9"/>
    </material>

    <!-- base_footprint is driven by TF (map -> base_footprint) from simulation_node -->
    <link name="base_footprint"/>
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${car_length} ${car_width} ${car_height}"/>
            </geometry>
            <material name="yellow"/>
        </visual>
    </link>

    <joint name="base_to_footprint" type="fixed">
        <parent link="base_footprint"/>
        <child  link="base_link"/>
        <origin xyz="0.0 0.0 ${car_height / 2.0 + ground_height}"/>
    </joint>
</robot>
